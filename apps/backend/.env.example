# Copy to .env and fill in real values for local development.
# Never commit a real .env with production secrets.

# PostgreSQL connection (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5432/ecommerce?schema=public"

# JWT secrets — generate with: openssl rand -base64 32
JWT_ACCESS_SECRET="dev-access-secret-change-me-please-123456"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-please-123456"

# Token lifetimes (e.g. 15m, 1h, 7d)
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Allowed browser origin for CORS (frontend dev server)
# Comma-separated allowed origins; include the admin portal, e.g.
# "https://example.com,https://admin.example.com"
FRONTEND_URL="http://localhost:3001,http://admin.localhost:3001"

# Backend port
PORT=3000

# Cancel unconfirmed (PENDING) orders after this many hours and put their stock back.
# Orders with a bKash/Nagad Transaction ID are never auto-cancelled. 0 turns it off.
PENDING_ORDER_TTL_HOURS=48

# Number of proxies in front of the API (1 on Railway / Render / behind nginx), so rate
# limits see each visitor's real IP. Leave empty when the API is reached directly.
TRUST_PROXY=
