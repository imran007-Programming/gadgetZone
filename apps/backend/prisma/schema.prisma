generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id                   String          @id @default(cuid())
  email                String          @unique
  passwordHash         String
  name                 String
  /// Bangladeshi mobile (01XXXXXXXXX), set from the profile page
  phone                String?
  role                 Role            @default(CUSTOMER)
  // Phase 5: admins can disable accounts; disabled users cannot log in
  isActive             Boolean         @default(true)
  // Phase 2: hashed refresh token for rotation + revocation
  refreshTokenHash     String?
  // Previous refresh token, still accepted for a short grace period after rotation
  // (a reload can drop the response that carried the new cookie)
  prevRefreshTokenHash String?
  refreshRotatedAt     DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  cartItems            CartItem[]
  orders               Order[]
  wishlistItems        WishlistItem[]
  reviews              Review[]
  returnRequests       ReturnRequest[]

  @@index([role])
}

/// Two levels: a top-level category (parentId null) and its subcategories.
model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  /// Display order among siblings (lower first)
  position    Int        @default(0)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId])
}

/// Single-row storefront settings (id "default"), edited in Admin → Site settings.
model SiteSetting {
  id                      String   @id @default("default")
  topbarEnabled           Boolean  @default(true)
  /// Left side of the top bar, e.g. "Corporate & Wholesale"
  topbarLeftTitle         String   @default("Corporate & Wholesale")
  topbarLeftText          String   @default("Get Special Business Pricing")
  topbarLeftLink          String   @default("/help")
  /// Center of the top bar: coupon or announcement (hidden when empty)
  announcement            String   @default("")
  announcementLink        String   @default("")
  /// Right side of the top bar
  supportPhone            String   @default("")
  /// Checkout delivery charges (BDT); Dhaka district counts as inside Dhaka
  deliveryFeeInsideDhaka  Int      @default(60)
  deliveryFeeOutsideDhaka Int      @default(99)
  /// Outside Dhaka the delivery charge is paid in advance by bKash / Nagad
  /// (only when at least one number below is set)
  advanceOutsideDhaka     Boolean  @default(true)
  bkashNumber             String   @default("")
  nagadNumber             String   @default("")
  updatedAt               DateTime @updatedAt
}

model Product {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  description   String
  price         Decimal        @db.Decimal(10, 2)
  comparePrice  Decimal?       @db.Decimal(10, 2)
  stock         Int            @default(0)
  imageUrl      String
  isActive      Boolean        @default(true)
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])
  brandId       String?
  brand         Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  images        ProductImage[]
  reviews       Review[]
  banners       Banner[]

  @@index([categoryId])
  @@index([brandId])
  // Storefront listing, one per sort option; id breaks ties for the "Load more" cursor
  @@index([isActive, createdAt, id])
  @@index([isActive, price, id])
  @@index([isActive, name, id])
  // Trigram indexes let search's "contains" (ILIKE '%word%') use an index (pg_trgm)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_name_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_description_trgm_idx")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  // Cloudinary public_id, needed to delete the asset later
  publicId  String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  // Lookups by userId use this unique index
  @@unique([userId, productId])
  @@index([productId])
}

model Order {
  id              String          @id @default(cuid())
  userId          String?
  user            User?           @relation(fields: [userId], references: [id])
  status          OrderStatus     @default(PENDING)
  totalAmount     Decimal         @db.Decimal(10, 2)
  shippingAddress Json
  // Guest checkout fields (null for logged-in users)
  guestName       String?
  guestPhone      String?
  guestEmail      String?
  paymentMethod   String          @default("cod")
  // Discount applied at checkout (0 when no coupon). totalAmount is already net of it.
  discountAmount  Decimal         @default(0) @db.Decimal(10, 2)
  couponId        String?
  coupon          Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode      String?
  /// Delivery charge included in totalAmount; zone is "inside_dhaka" or "outside_dhaka"
  shippingFee     Decimal         @default(0) @db.Decimal(10, 2)
  shippingZone    String?
  /// bKash / Nagad Transaction ID for the advance delivery charge
  transactionId   String?
  /// Customer's order notes
  notes           String?
  /// Billing contact when the order ships to a different address (null = same as shipping)
  billingAddress  Json?
  /// Idempotency-Key the checkout sent: a retry with the same key gets this order back
  /// instead of creating a duplicate (null for orders placed without one)
  idempotencyKey  String?         @unique
  /// SHA-256 of that request's body, so a reused key with different contents is refused
  idempotencyHash String?
  returnRequests  ReturnRequest[]
  createdAt       DateTime        @default(now())
  items           OrderItem[]

  // A customer's orders, newest first
  @@index([userId, createdAt])
  // Admin list by status, revenue reports, auto-cancel of old PENDING orders
  @@index([status, createdAt])
  @@index([createdAt])
  // Coupon usage counts
  @@index([couponId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  @@index([orderId])
  // Review eligibility and sales reports look items up by product
  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Lookups by userId use this unique index
  @@unique([userId, productId])
  @@index([productId])
}

enum DiscountType {
  PERCENT
  FLAT
}

model Coupon {
  id        String       @id @default(cuid())
  code      String       @unique
  type      DiscountType
  // Percent (1–100) or a flat BDT amount, depending on type
  value     Decimal      @db.Decimal(10, 2)
  minOrder  Decimal?     @db.Decimal(10, 2)
  maxUses   Int?
  usedCount Int          @default(0)
  expiresAt DateTime?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  orders    Order[]
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  status    ReviewStatus @default(PENDING)
  reply     String?
  repliedAt DateTime?
  createdAt DateTime     @default(now())

  @@unique([userId, productId])
  @@index([productId, status])
  @@index([status])
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

model ReturnRequest {
  id           String       @id @default(cuid())
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason       String
  details      String?
  status       ReturnStatus @default(REQUESTED)
  refundAmount Decimal?     @db.Decimal(10, 2)
  adminNote    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([orderId])
  @@index([status])
  // A customer's returns, newest first
  @@index([userId, createdAt])
}

/// Homepage carousel slide (image only), managed from the admin dashboard.
/// Clicking it opens the linked product, or ctaHref when no product is set.
model Banner {
  id        String    @id @default(cuid())
  // Internal name, also used as the image alt text
  title     String
  productId String?
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  ctaHref   String?
  // Cloudinary URL, or a /public path for the original built-in banners
  imageUrl  String
  // Cloudinary public_id; null for built-in images that are not on Cloudinary
  publicId  String?
  position  Int       @default(0)
  isActive  Boolean   @default(true)
  // Optional schedule: shown only between these dates when set
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive, position])
}

/// Product brand (Sony, Apple, …), managed from the admin dashboard.
model Brand {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  description    String?
  // Cloudinary logo; null shows the brand initials instead
  logoUrl        String?
  logoPublicId   String?
  // Wide cover image shown at the top of the brand page
  bannerUrl      String?
  bannerPublicId String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  products       Product[]
}
